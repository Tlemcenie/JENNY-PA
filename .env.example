# ──────────────────────────────────────────────────────────────────────
# Jenny — Variables d'environnement
#
# 1. Copier ce fichier vers .env
# 2. Remplir les valeurs (voir docs/SETUP_CONNECTORS.md pour les clés API)
# 3. Toutes les variables consommées utilisent le préfixe JENNY_*
#
# En dev local : utiliser les valeurs par défaut (Mailhog, Groq, mock, etc)
# En production : remplacer par les vrais tokens
# ──────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
JENNY_ENV=dev
JENNY_DEBUG=true
JENNY_LOG_LEVEL=INFO
JENNY_APP_NAME=Jenny

# ── API ──────────────────────────────────────────────────────────
JENNY_API_HOST=0.0.0.0
JENNY_API_PORT=8000

# ── Auth API ─────────────────────────────────────────────────────
# DEV local : REQUIRE_AUTH peut rester false (API publique, pratique pour tester).
# PROD : OBLIGATOIREMENT true — sinon tous les endpoints sont ouverts.
JENNY_REQUIRE_AUTH=false
# Secret de signature JWT. Générer une vraie valeur :
#   openssl rand -hex 32      (ou)   python -c "import secrets; print(secrets.token_hex(32))"
# La valeur ci-dessous est un placeholder volontairement invalide : NE JAMAIS la déployer.
JENNY_JWT_SECRET=CHANGE_ME__run_openssl_rand_hex_32
JENNY_JWT_ALGORITHM=HS256
JENNY_JWT_EXP_MINUTES=1440

# ── PostgreSQL + pgvector ────────────────────────────────────────
# En Docker, l'host devient "postgres" (cf. docker-compose.yml).
JENNY_DATABASE_URL=postgresql+asyncpg://jenny:jenny_secret@localhost:5432/jenny

# ── Redis ────────────────────────────────────────────────────────
JENNY_REDIS_URL=redis://localhost:6379/0

# ── LLM (provider par défaut : groq) ─────────────────────────────
# Provider possible : groq | openai | mistral | llama | nanogpt
# Pour obtenir les clés : voir docs/SETUP_CONNECTORS.md
JENNY_LLM_PROVIDER=groq
JENNY_LLM_MODEL=llama-3.3-70b-versatile

# Groq (recommandé en dev) — Gratuit avec quota généreux
# S'inscrire: https://console.groq.com
JENNY_GROQ_API_KEY=gsk_...

# OpenAI — GPT-4o, payant
# S'inscrire: https://platform.openai.com/api-keys
JENNY_OPENAI_API_KEY=sk-...

# Mistral — Mistral Small/Large, payant
# S'inscrire: https://console.mistral.ai
JENNY_MISTRAL_API_KEY=mvsk_...

# Ollama/vLLM local — Gratuit, modèles locaux
JENNY_LLAMA_BASE_URL=http://localhost:11434

# ── MLflow Tracking ──────────────────────────────────────────────
JENNY_MLFLOW_TRACKING_URI=http://localhost:5000

# ── WhatsApp Business API (Meta Cloud API) ───────────────────────
# Obtenir les clés: https://developers.facebook.com
# Guide complet: docs/SETUP_CONNECTORS.md#whatsapp
# 
# Étapes:
# 1. Créer app Meta (https://developers.facebook.com)
# 2. Ajouter produit "WhatsApp"
# 3. Générer token d'accès + obtenir PHONE_NUMBER_ID
# 4. Configurer webhook: https://your-domain.com/webhooks/whatsapp
JENNY_WHATSAPP_PHONE_NUMBER_ID=
JENNY_WHATSAPP_ACCESS_TOKEN=
JENNY_WHATSAPP_VERIFY_TOKEN=jenny-whatsapp-verify
JENNY_WHATSAPP_API_VERSION=v21.0

# ── Instagram Messaging API (Meta) ───────────────────────────────
# Obtenir les clés: https://developers.facebook.com
# Guide complet: docs/SETUP_CONNECTORS.md#instagram
JENNY_INSTAGRAM_PAGE_ID=
JENNY_INSTAGRAM_ACCESS_TOKEN=
JENNY_INSTAGRAM_VERIFY_TOKEN=jenny-instagram-verify

# ── Twitter / X ──────────────────────────────────────────────────
# Obtenir les clés: https://developer.twitter.com
# Guide complet: docs/SETUP_CONNECTORS.md#twitter
JENNY_TWITTER_API_KEY=
JENNY_TWITTER_API_SECRET=
JENNY_TWITTER_ACCESS_TOKEN=
JENNY_TWITTER_ACCESS_TOKEN_SECRET=
JENNY_TWITTER_BEARER_TOKEN=
JENNY_TWITTER_WEBHOOK_ENV=production

# ── Snapchat for Business ────────────────────────────────────────
# Obtenir les clés: https://ads.snapchat.com
# Guide complet: docs/SETUP_CONNECTORS.md#snapchat
JENNY_SNAPCHAT_CLIENT_ID=
JENNY_SNAPCHAT_CLIENT_SECRET=
JENNY_SNAPCHAT_ACCESS_TOKEN=

# ── Email SMTP (envoi de mails) ──────────────────────────────────
# Option A: Mailhog (local, dev) - Capture tous les emails:
#   JENNY_SMTP_HOST=mailhog
#   JENNY_SMTP_PORT=1025
#   JENNY_SMTP_USE_TLS=false
#   Accéder à l'UI: http://localhost:8025
#
# Option B: Gmail (via App Password) - S'inscrire: https://myaccount.google.com
#   1. Activer OAuth 2FA
#   2. Générer App Password (pour app Mail)
#   3. Copier le mot de passe généré
#
# Guide complet: docs/SETUP_CONNECTORS.md#email
JENNY_SMTP_HOST=smtp.gmail.com
JENNY_SMTP_PORT=587
JENNY_SMTP_USERNAME=
JENNY_SMTP_PASSWORD=
JENNY_SMTP_FROM_EMAIL=
JENNY_SMTP_FROM_NAME=Jenny
JENNY_SMTP_USE_TLS=true

# Backend d'envoi d'email :
#   auto    : SMTP si identifiants présents, sinon fichier (dev) / console (test)
#   smtp    : envoi réel via le serveur SMTP ci-dessus
#   file    : écrit le HTML rendu dans JENNY_EMAIL_PREVIEW_DIR (ouvrable au navigateur)
#   console : trace l'email dans les logs (tests)
JENNY_EMAIL_BACKEND=auto
JENNY_EMAIL_PREVIEW_DIR=var/emails
# Validité du code de confirmation d'email à l'inscription (minutes).
JENNY_EMAIL_VERIFICATION_TTL_MINUTES=15
# URL publique du front (liens/branding dans les emails).
JENNY_APP_BASE_URL=http://localhost:3000
# Origines CORS autorisées : "*" en dev. En PROD, mettre l'URL du frontend
# (plusieurs séparées par des virgules), ce qui active aussi les credentials.
# Ex. prod : JENNY_CORS_ORIGINS=https://app.mon-salon.fr
JENNY_CORS_ORIGINS=*

# ── SMS Twilio ───────────────────────────────────────────────────
# Obtenir les clés: https://www.twilio.com/try-twilio
# Guide complet: docs/SETUP_CONNECTORS.md#twilio
# 1. S'inscrire (essai gratuit)
# 2. Copier Account SID, Auth Token (dans Console)
# 3. Acheter/réserver un numéro
JENNY_TWILIO_ACCOUNT_SID=
JENNY_TWILIO_AUTH_TOKEN=
JENNY_TWILIO_PHONE_NUMBER=

# ── Google Calendar (RDV réels) ──────────────────────────────────
# Obtenir les clés: https://console.cloud.google.com
# Guide complet: docs/SETUP_CONNECTORS.md#google-calendar
# 1. Créer projet GCP
# 2. Activer Google Calendar API
# 3. Créer compte de service
# 4. Télécharger clé JSON
# 5. Partager le calendrier avec l'adresse email du compte de service
JENNY_GOOGLE_CALENDAR_ID=primary
JENNY_GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Meta webhooks (signature HMAC) ───────────────────────────────
# Copier depuis https://developers.facebook.com → App settings → Basic
# Required pour valider les webhooks WhatsApp/Instagram (sécurité)
# En dev: utiliser JENNY_SKIP_META_SIGNATURE=true (attention !)
JENNY_FACEBOOK_APP_SECRET=
JENNY_SKIP_META_SIGNATURE=false
JENNY_DEFAULT_BUSINESS_ID=

# ── OAuth Google (pour dashboard web) ────────────────────────────
# Optionnel si vous utilisez la UI web
# S'inscrire: https://console.cloud.google.com
JENNY_GOOGLE_OAUTH_CLIENT_ID=
JENNY_GOOGLE_OAUTH_CLIENT_SECRET=
JENNY_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Paiements ────────────────────────────────────────────────────
# Stripe
# Guide complet: docs/SETUP_CONNECTORS.md#stripe
# S'inscrire: https://dashboard.stripe.com
# Mode test (sk_test_) pour développement
JENNY_STRIPE_SECRET_KEY=sk_test_...
JENNY_STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
# Guide complet: docs/SETUP_CONNECTORS.md#paypal
# S'inscrire: https://www.paypal.com/en/business
# Mode sandbox (tests) ou production
JENNY_PAYPAL_CLIENT_ID=
JENNY_PAYPAL_CLIENT_SECRET=
JENNY_PAYPAL_WEBHOOK_ID=
JENNY_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── Email inbound (IMAP) ─────────────────────────────────────────
# Optionnel: pour recevoir les réponses via email
# Même type de configuration que SMTP (Gmail App Password, etc)
JENNY_EMAIL_INBOUND_SECRET=
JENNY_IMAP_HOST=
JENNY_IMAP_USER=
JENNY_IMAP_PASSWORD=
JENNY_IMAP_MAILBOX=INBOX
JENNY_IMAP_POLL_SECONDS=120
JENNY_IMAP_USE_SSL=true
JENNY_IMAP_BUSINESS_ID=

# ── Observabilité (optionnel) ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jenny

# ── Bootstrap local ──────────────────────────────────────────────
# Si =1, l'entrypoint Docker insère le user/business démo
# (demo@jenny.ai / Demo!1234) au démarrage de l'API.
JENNY_AUTO_SEED=1
