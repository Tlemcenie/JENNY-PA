# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──
.venv/
venv/
env/

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
.cursor/

# ── Environment ──
.env
.env.local
.env.*.local

# ── Data (tracked via .gitkeep) ──
data/raw/*
data/interim/*
data/processed/*
data/labeled/*
data/synthetic/*
!data/**/.gitkeep

# ── ML artifacts ──
mlruns/
mlartifacts/
# Poids PyTorch : ignorés sauf checkpoints versionnés pour CI / tests e2e
*.pt
!checkpoints/intent/best_model.pt
!checkpoints/ner/best_model.pt
*.pth
*.ckpt
*.onnx

# ── Logs ──
logs/
*.log

# ── Docker ──
.docker/

# ── OS ──
.DS_Store
Thumbs.db

# ── Notebooks checkpoints ──
.ipynb_checkpoints/

# ── Coverage ──
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── Mypy ──
.mypy_cache/

# ── Ruff ──
.ruff_cache/

# ── Pytest ──
.pytest_cache/

# ── Node / Next.js (frontend) ──
node_modules/
.next/
out/
next-env.d.ts
playwright-report/
test-results/
.turbo/

# ── Runtime local (NE PAS versionner) ──
# Tout var/ : cluster Postgres natif, logs API/Ollama, emails de dev,
# rapports d'éval, checkpoints d'entraînement locaux. Purement runtime.
var/
# Dump Redis (snapshot RDB local).
dump.rdb
# Images générées en vrac à la racine (brouillons, non utilisées par l'app).
Gemini_Generated_Image_*.png
*.tsbuildinfo

# Bases SQLite de test (éphémères)
test.db
*.db-journal
*.sqlite
*.sqlite3

# Fichiers de verrouillage Office (ouverts dans PowerPoint/Word)
~$*.pptx
~$*.docx

# ── Livrables générés à la racine (présentations, rapports, audits) ──
# On ne versionne pas les .pptx/.docx/.pdf : ce sont des exports lourds,
# régénérables (scripts/make_presentation.py) ou personnels (slides de soutenance).
/*.pptx
/*.docx
/*.pdf

# ── Notebooks Colab : garder seulement le .ipynb source généré par
#    scripts/build_notebook.py (JENNY_NanoGPT_FromScratch.ipynb). ──
/JENNY_NanoGPT_T4_Colab*.ipynb
*_ipynb.txt
