# ── Frontend Jenny — configuration locale (Next.js) ──
# Copie ce fichier en `.env.local` puis adapte si besoin :
#   cp .env.local.example .env.local
#
# URL de l'API backend, vue depuis le NAVIGATEUR. En dev local (API sur le port
# 8000, lancée par `make demo-up` ou `docker compose up`), la valeur par défaut
# convient. À changer uniquement si l'API tourne ailleurs (autre port/host).
NEXT_PUBLIC_API_URL=http://localhost:8000
